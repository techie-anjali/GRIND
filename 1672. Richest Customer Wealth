class Solution {
    public int maximumWealth(int[][] accounts) {
        int mxwealth=0;
        int m=accounts.length;
  
    
        for(int i=0;i<m;i++){
            int currwealth=0;
            for(int j=0;j<accounts[i].length;j++){
                currwealth+=accounts[i][j];
            }
         mxwealth=Math.max(mxwealth,currwealth);
        }
    

    return mxwealth;
    }
}
